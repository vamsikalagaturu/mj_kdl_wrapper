prefix=${pcfiledir}/@_MJ_KDL_PC_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mj_kdl_wrapper
Description: MuJoCo physics with Orocos KDL kinematics and dynamics
Version: @PROJECT_VERSION@
Requires: orocos-kdl
Cflags: -I${includedir}
Libs: -L${libdir} -lmj_kdl_wrapper -lmujoco -Wl,--disable-new-dtags -Wl,-rpath,${libdir} @_MJ_KDL_PC_KDL_RPATH@
