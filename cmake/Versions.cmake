set(MJKDL_VERSION "0.5.0")
set(MJKDL_MUJOCO_VERSION "3.14.0")
# sha256 of mujoco-<version>-linux-x86_64.tar.gz; scripts/update_mujoco_version.py rewrites it.
set(MJKDL_MUJOCO_SHA256 "326f0da78a7767cc18fab7205c993a771b5f19eda913648f958ee3f625240944")
set(MJKDL_GOOGLETEST_GIT_TAG "v1.15.2")

if(NOT MJKDL_MUJOCO_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
  message(FATAL_ERROR "Invalid MJKDL_MUJOCO_VERSION: ${MJKDL_MUJOCO_VERSION}")
endif()

set(MJKDL_MUJOCO_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(MJKDL_MUJOCO_VERSION_MINOR "${CMAKE_MATCH_2}")
set(MJKDL_MUJOCO_VERSION_PATCH "${CMAKE_MATCH_3}")
math(
  EXPR
  MJKDL_MUJOCO_VERSION_HEADER
  "${MJKDL_MUJOCO_VERSION_MAJOR} * 1000000 + ${MJKDL_MUJOCO_VERSION_MINOR} * 1000
   + ${MJKDL_MUJOCO_VERSION_PATCH}"
)
