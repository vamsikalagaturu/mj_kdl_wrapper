set(MJ_KDL_VERSION "0.5.1")
set(MJ_KDL_MUJOCO_VERSION "3.14.0")
# sha256 of mujoco-<version>-linux-x86_64.tar.gz; scripts/update_mujoco_version.py rewrites it.
set(MJ_KDL_MUJOCO_SHA256 "326f0da78a7767cc18fab7205c993a771b5f19eda913648f958ee3f625240944")
set(MJ_KDL_GOOGLETEST_GIT_TAG "v1.15.2")

if(NOT MJ_KDL_MUJOCO_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
  message(FATAL_ERROR "Invalid MJ_KDL_MUJOCO_VERSION: ${MJ_KDL_MUJOCO_VERSION}")
endif()

set(MJ_KDL_MUJOCO_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(MJ_KDL_MUJOCO_VERSION_MINOR "${CMAKE_MATCH_2}")
set(MJ_KDL_MUJOCO_VERSION_PATCH "${CMAKE_MATCH_3}")
math(
  EXPR
  MJ_KDL_MUJOCO_VERSION_HEADER
  "${MJ_KDL_MUJOCO_VERSION_MAJOR} * 1000000 + ${MJ_KDL_MUJOCO_VERSION_MINOR} * 1000
   + ${MJ_KDL_MUJOCO_VERSION_PATCH}"
)
