<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mj_kdl_wrapper</name>
  <version>0.1.0</version>
  <description>
    C++ library bridging MuJoCo physics simulation with the Orocos KDL kinematics
    and dynamics library. Builds as a plain CMake package; this manifest only lets
    colcon order and discover it inside a ROS 2 workspace. Plain CMake and pip
    builds ignore this file.
  </description>
  <maintainer email="tools@vamsi.sh">Vamsi Kalagaturu</maintainer>
  <license>MIT</license>

  <buildtool_depend>cmake</buildtool_depend>

  <!--
    Orocos KDL is the pinned secorolab fork built from source by CMake, not the
    system liborocos-kdl, so it is intentionally not declared here. MuJoCo is
    fetched by CMake (or taken from MJ_KDL_MUJOCO_DIR). The keys below are the
    system libraries rosdep can install.
  -->
  <depend>eigen</depend>
  <depend>libglfw3-dev</depend>
  <depend>git</depend>
  <exec_depend>ffmpeg</exec_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
