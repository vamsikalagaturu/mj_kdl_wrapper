# Doxyfile.in -- CMake-configured Doxygen settings for mj-kdl-wrapper.
# Processed by configure_file(); variables like @VAR@ are substituted.
#
# Generate docs:
#   cmake -B build -DBUILD_DOCS=ON
#   cmake --build build --target docs
# Output: @CMAKE_CURRENT_BINARY_DIR@/docs/html/index.html

PROJECT_NAME           = "Mujoco KDL Wrapper"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "MuJoCo + KDL bridge for robot kinematics and dynamics"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# --- Input ---
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/include \
                         @CMAKE_CURRENT_SOURCE_DIR@/README.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen/groups.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/index.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/tutorials/cpp.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/tutorials/python.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/api/cpp.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/api/python.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/examples.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/howto/urdf_to_mjcf.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/howto/torque_control.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/python/mj_kdl_wrapper \
                         @CMAKE_CURRENT_SOURCE_DIR@/python/examples \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/examples \
                         @CMAKE_CURRENT_SOURCE_DIR@/test
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.cpp *.md *.py *.pyi
EXTENSION_MAPPING      = pyi=Python
IMAGE_PATH             = @CMAKE_CURRENT_SOURCE_DIR@/docs/screenshots
EXCLUDE_PATTERNS       = */third_party/* */build/* */__pycache__/*

# Use README.md as the main page
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/README.md

# --- Extraction ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

# --- Source browsing ---
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
TAGFILES               = @MJ_KDL_DOXYGEN_TAGFILES@
EXTERNAL_GROUPS        = NO
EXTERNAL_PAGES         = NO

# --- HTML output ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

# Local Doxygen theme
HTML_HEADER            = @CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen/custom/header.html
HTML_EXTRA_STYLESHEET  = @CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen/custom/mjk-doxygen.css
HTML_EXTRA_FILES       = @CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen/custom/mjk-doxygen.js

# Navigation
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_COPY_CLIPBOARD    = NO

# --- LaTeX / other formats ---
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# --- Preprocessing ---
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = MJ_KDL_HAS_EGL

# --- Diagrams ---
HAVE_DOT               = NO

# --- Warnings ---
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
