/**
 * @defgroup grp_types Data Types
 * @brief Structs and enums that describe the scene, robot, and visualization state.
 *
 * These are the primary configuration and runtime handle types.
 * Populate them before calling any scene-building or robot-init function.
 */

/**
 * @defgroup grp_scene Scene Building
 * @brief Build and modify MuJoCo scenes from MJCF specifications.
 *
 * init_env() builds the scene into an Env.  Use scene_add_object() and
 * scene_remove_object() to modify a running Env; bind scene slots (joints, free
 * bodies, wrenches, actuators outside a Robot chain) with bind_scene_*().
 */

/**
 * @defgroup grp_robot Robot Initialization and Control
 * @brief Initialize KDL chains and command robots through their ports.
 *
 * Call init_robot_from_mjcf() once after init_env(); it registers the robot
 * with the Env, whose update() then reads and commands it every control step.
 */

/**
 * @defgroup grp_env Runtime Environment
 * @brief The Env: owns model/data, robots, scene slots and the viewer.
 *
 * init_env() builds it; step(), update() and reset() drive it; cleanup(Env *)
 * frees it.  reset() re-seeds every part it holds.
 */

/**
 * @defgroup grp_viewer Visualization
 * @brief The simulate UI of an Env and loop pacing.
 *
 * Use open_viewer() + step() for the simulate UI with physics panels.
 *
 * The simulate UI owns a user scene merged into every frame; draw your own
 * overlay geometry (e.g. a live end-effector trajectory trace) into it with
 * clear_trace() and add_trace_segment().  Both are no-ops in headless mode.
 */

/**
 * @defgroup grp_recorder Video Recording
 * @brief Headless H.264 video recording via EGL offscreen rendering and ffmpeg.
 *
 * No display or GLFW window is needed.  Requires EGL (libegl-dev) and
 * ffmpeg in PATH.  Enable with -DBUILD_RECORDER=ON (default).
 */

/**
 * @defgroup grp_logging Logging
 * @brief Control verbosity of library diagnostic messages.
 */
