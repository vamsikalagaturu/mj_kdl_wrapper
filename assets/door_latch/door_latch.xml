<!--
  Latched cupboard door fixture, box-built (no meshes).
  Local frame: +x toward the robot (after the scene's half-turn), +y across, +z up.
  Mechanism: the lever (hinge about the door-face normal, spring-returned) carries a bolt on
  the far side of its pivot; at rest the bolt sits behind a strike lip on the carcass, so the
  door cannot swing until the lever is rotated ~30 deg and the bolt clears the lip.
  Bar height (0.2475 above the base) matches the drawer cabinet's top handle, so the same arm
  workspace and staging poses carry over.
-->
<mujoco model="door_latch">
  <compiler angle="radian" autolimits="true"/>

  <asset>
    <material name="carcass" rgba="0.28 0.42 0.30 1"/>
    <material name="doorface" rgba="0.16 0.55 0.30 1"/>
    <material name="lever" rgba="1 0.45 0 0.9"/>
    <material name="steel" rgba="0.55 0.58 0.62 1"/>
  </asset>

  <worldbody>
    <body name="root">
      <!-- carcass: interior 0.32 wide x 0.36 tall, 0.24 deep, opening on the +x face -->
      <geom name="carcass_bottom" type="box" pos="-0.125 0 0.010" size="0.125 0.180 0.010" material="carcass"/>
      <geom name="carcass_top"    type="box" pos="-0.125 0 0.370" size="0.125 0.180 0.010" material="carcass"/>
      <geom name="carcass_left"   type="box" pos="-0.125 0.170 0.190" size="0.125 0.010 0.190" material="carcass"/>
      <geom name="carcass_right"  type="box" pos="-0.125 -0.170 0.190" size="0.125 0.010 0.190" material="carcass"/>
      <geom name="carcass_back"   type="box" pos="-0.245 0 0.190" size="0.005 0.180 0.190" material="carcass"/>
      <!-- strike lip: catches the bolt in front until the lever swings it clear -->
      <geom name="strike_lip" type="box" pos="0.058 -0.185 0.2475" size="0.008 0.014 0.010" material="steel" friction="0.4 0.02 0.001"/>

      <!-- door: hinged on the left vertical edge, swings toward the robot for +angle -->
      <body name="door" pos="0.012 0.170 0.190">
        <joint name="door_hinge" type="hinge" axis="0 0 1" range="-0.02 2.0" damping="0.6"/>
        <inertial pos="0 -0.16 0" mass="1.2" diaginertia="0.02 0.02 0.02"/>
        <geom name="door_panel" type="box" pos="0 -0.160 0" size="0.008 0.160 0.185" material="doorface" friction="0.6 0.02 0.001"/>

        <!-- lever: spring-returned hinge about the door-face normal; bar toward the hinge
             side, bolt on the far side of the pivot reaching past the door edge -->
        <body name="lever" pos="0.020 -0.280 0.0575">
          <joint name="lever_hinge" type="hinge" axis="1 0 0" range="-0.9 0.05" stiffness="0.15" damping="0.02"/>
          <inertial pos="0.02 0 0" mass="0.10" diaginertia="0.0002 0.0002 0.0002"/>
          <geom name="lever_post" type="capsule" fromto="0.004 0 0  0.030 0 0" size="0.006" material="lever" friction="1.2 0.05 0.005"/>
          <geom name="lever_bar"  type="capsule" fromto="0.030 0 0  0.030 0.096 0" size="0.009" material="lever" friction="1.2 0.05 0.005"/>
          <geom name="latch_bolt" type="box" pos="0.012 -0.055 0" size="0.006 0.032 0.006" material="steel" friction="0.4 0.02 0.001"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
