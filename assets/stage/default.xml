<!-- The stage every scene gets unless SceneSpec::stage names another one: an infinite checker
     floor and a gradient sky with matching haze, as in MuJoCo's model/humanoid/humanoid.xml,
     lit as MuJoCo Menagerie's robot scenes are (a headlight with ambient light and a
     directional light from above). The floor is left unnamed so it cannot clash with a geom an
     asset calls "floor"; SceneSpec::floor_z moves every plane on the worldbody. -->
<mujoco model="mj_kdl_wrapper stage">
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="32" height="512"/>
    <texture name="groundplane" type="2d" builtin="checker" rgb1="0.1 0.2 0.3"
             rgb2="0.2 0.3 0.4" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texrepeat="1 1" texuniform="true"
              reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="sun" type="directional" pos="0 0 1.5" dir="0 0 -1"/>
    <geom type="plane" size="0 0 0.05" material="groundplane" condim="3"/>
  </worldbody>
</mujoco>
