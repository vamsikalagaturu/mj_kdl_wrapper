<!-- One motor-driven wheel on a motor-driven pivot, as on a KELO drive: the wheel takes velocity
     and torque modes, the pivot is left out of them. -->
<mujoco model="motor_wheel">
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <body name="drive">
      <joint name="pivot" type="hinge" axis="0 0 1" damping="0.1"/>
      <geom type="box" size="0.05 0.05 0.02" mass="1"/>
      <body name="wheel" pos="0 0 -0.05">
        <joint name="wheel" type="hinge" axis="0 1 0" damping="0.01" armature="0.002"/>
        <geom type="cylinder" size="0.05 0.02" quat="0.7071068 0.7071068 0 0" mass="0.3"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="pivot" joint="pivot" gear="4" ctrlrange="-10 10"/>
    <motor name="wheel" joint="wheel" gear="1" ctrlrange="-12 12"/>
  </actuator>
</mujoco>
